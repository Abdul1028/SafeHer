<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- User Info Section -->
        <TextView
            android:id="@+id/userEmailTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Logged in as: user@example.com"
            android:textSize="16sp"
            android:textColor="@color/black"
            android:layout_marginBottom="24dp"
            android:visibility="gone" />

        <!-- Emergency Contacts Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Contacts (Max 5)"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <!-- Button to Open Contact Picker -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectContactsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Contacts"
            android:backgroundTint="@color/purple"
            android:textColor="@color/white"
            app:cornerRadius="8dp"
            android:layout_marginBottom="8dp" />

        <!-- List of Selected Contacts -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Selected Contacts:"
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/selectedContactsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- SOS Message Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOS Message"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/messageBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Message to send (include [Location] for coordinates)"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:gravity="top"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SOS Options Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SOS Actions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="8dp"
            app:cardElevation="4dp"
            app:strokeColor="@color/purple"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/playSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Play Loud Sound"
                    android:checked="true"
                    app:buttonTint="@color/purple" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/sendSMS"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Send SMS to Contacts"
                    android:checked="true"
                    app:buttonTint="@color/purple" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/sendNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Send Notification (Placeholder)"
                    android:checked="true"
                    app:buttonTint="@color/purple"
                    android:layout_marginBottom="16dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Settings"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/purple"
            android:textColor="@color/white"
            app:cornerRadius="8dp" />

        <!-- Sign Out Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/signOutButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sign Out"
            android:layout_marginTop="16dp"
            android:textColor="@color/purple"
            app:strokeColor="@color/purple"
            app:cornerRadius="8dp"
            android:visibility="gone"/>

    </LinearLayout>
</ScrollView>